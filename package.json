{
  "name": "@karmadev.studio/google-login-preflight",
  "version": "0.1.0",
  "description": "Dependency-free CLI for diagnosing Google login configuration issues on the web",
  "type": "module",
  "bin": {"google-login-preflight": "bin/google-login-preflight.js"},
  "exports": {".": {"types": "./src/index.d.ts", "default": "./src/index.js"}},
  "types": "./src/index.d.ts",
  "files": ["bin", "src", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {"node": ">=20"},
  "keywords": ["google-login", "google-identity-services", "preflight", "oauth", "fedcm", "csp", "diagnostics", "cli"],
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/alicekolenko/react-google-login-GIS.git"},
  "publishConfig": {"access": "public"}
}
